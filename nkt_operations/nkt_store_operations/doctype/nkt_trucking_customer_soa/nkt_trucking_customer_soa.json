{
  "doctype": "DocType",
  "name": "NKT Trucking Customer SOA",
  "module": "NKT Store Operations",
  "custom": 0,
  "autoname": "naming_series:",
  "naming_rule": "By \"Naming Series\" field",
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "naming_series",
    "header_section",
    "business_name",
    "customer",
    "statement_date",
    "column_break_header",
    "status",
    "company",
    "print_layout",
    "resolved_layout",
    "period_section",
    "period_start",
    "period_end",
    "prepared_by",
    "prepared_by_user",
    "column_break_period",
    "received_by",
    "received_date",
    "prepared_at",
    "finalized_at",
    "defaults_section",
