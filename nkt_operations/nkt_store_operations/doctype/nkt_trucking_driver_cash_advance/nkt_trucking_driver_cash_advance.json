{
  "doctype": "DocType",
  "name": "NKT Trucking Driver Cash Advance",
  "module": "NKT Store Operations",
  "custom": 0,
  "autoname": "naming_series:",
  "naming_rule": "By \"Naming Series\" field",
  "engine": "InnoDB",
  "track_changes": 1,
  "allow_rename": 0,
  "field_order": [
    "naming_series",
    "header_section",
    "advance_date",
    "driver_name",
    "scope",
    "column_break_header",
    "status",
    "company",
    "trip_section",
    "source_trip",
    "vehicle",
    "plate_no",
    "fleet_ownership_snapshot",
    "money_section",
    "amount",
    "outstanding_amount",
    "column_break_money",
    "release_reference",
    "accounting_posting_status",
    "audit_section",
    "released_by_user",
    "released_at",
    "liquidation",
    "remarks"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "TRK-ADV-.YYYY.-.#####",
      "default": "TRK-ADV-.YYYY.-.#####",
      "hidden": 1
    },
    {
      "fieldname": "header_section",
      "fieldtype": "Section Break",
      "label": "Driver Cash Advance"
    },
    {
      "fieldname": "advance_date",
      "fieldtype": "Date",
      "label": "Advance Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "driver_name",
      "fieldtype": "Data",
      "label": "Driver",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Actual person receiving the cash advance. For a trip-specific advance, this must match the actual Driver on the linked Trip."
    },
    {
      "fieldname": "scope",
      "fieldtype": "Select",
      "label": "Advance Scope",
      "options": "Trip-Specific\nGeneral ENT Operations",
      "default": "Trip-Specific",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_header",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nReleased\nLiquidation Submitted\nSettled\nCancelled",
      "default": "Draft",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "ERP Company (when configured)",
      "options": "Company",
      "description": "Company-aware only. C14E does not create or assume an ENT legal ERP Company."
    },
    {
      "fieldname": "trip_section",
      "fieldtype": "Section Break",
      "label": "Trip / Vehicle"
    },
    {
      "fieldname": "source_trip",
      "fieldtype": "Link",
      "label": "Source Trip",
      "options": "NKT Trucking Trip",
      "in_list_view": 1
    },
    {
      "fieldname": "vehicle",
      "fieldtype": "Link",
      "label": "Truck / Vehicle",
      "options": "NKT Vehicle",
      "in_list_view": 1
    },
    {
      "fieldname": "plate_no",
      "fieldtype": "Data",
      "label": "Plate No.",
      "read_only": 1,
      "fetch_from": "vehicle.plate_number"
    },
    {
      "fieldname": "fleet_ownership_snapshot",
      "fieldtype": "Select",
      "label": "Fleet Ownership Snapshot",
      "options": "Unclassified\nENT-Owned\nExternal Carrier",
      "read_only": 1,
      "description": "Copied from the linked Trip when trip-specific. Cash accountability is kept separate from ENT driver-incentive eligibility."
    },
    {
      "fieldname": "money_section",
      "fieldtype": "Section Break",
      "label": "Cash Accountability"
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Advance Amount",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "outstanding_amount",
      "fieldtype": "Currency",
      "label": "Outstanding Cash to Account For",
      "read_only": 1,
      "in_list_view": 1,
      "description": "Starts at the released advance amount. After liquidation verification, this becomes the unused cash expected back; after settlement it becomes zero."
    },
    {
      "fieldname": "column_break_money",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "release_reference",
      "fieldtype": "Data",
      "label": "Release / Voucher Reference",
      "description": "Optional operational reference. C14E does not guess or post a GL/cash account."
    },
    {
      "fieldname": "accounting_posting_status",
      "fieldtype": "Data",
      "label": "Accounting Posting",
      "read_only": 1,
      "default": "Operational Only — No GL Posting",
      "description": "C14E is operational accountability only. Formal accounting integration remains a later controlled gate."
    },
    {
      "fieldname": "audit_section",
      "fieldtype": "Section Break",
      "label": "Release / Liquidation Audit"
    },
    {
      "fieldname": "released_by_user",
      "fieldtype": "Link",
      "label": "Released By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "released_at",
      "fieldtype": "Datetime",
      "label": "Released At",
      "read_only": 1
    },
    {
      "fieldname": "liquidation",
      "fieldtype": "Link",
      "label": "Linked Liquidation",
      "options": "NKT Trucking Driver Liquidation",
      "read_only": 1
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Small Text",
      "label": "Purpose / Remarks"
    }
  ],
  "permissions": [
    {
      "role": "NKT Trucking Operations",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "report": 1,
      "export": 0
    },
    {
      "role": "NKT OWNER",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "NKT ADMINISTRATOR",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "print": 1,
      "report": 1,
      "export": 1
    }
  ],
  "links": [],
  "actions": [],
  "states": [],
  "sort_field": "modified",
  "sort_order": "DESC",
  "owner": "Administrator",
  "modified_by": "Administrator"
}
